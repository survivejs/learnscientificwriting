From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juho Vepsalainen <juho@survivejs.com>
Date: Tue, 5 May 2026 00:00:00 +0300
Subject: [PATCH] Parse nested LaTeX commands inside single commands

Single-command expressions such as \footnote{...} currently recurse only
through other single-command expressions. That leaves nested double-command
expressions, for example \href{url}{text}, as raw LaTeX text in the output.

This patch lets the single parser try configured double parsers while reading
single-command content. It also adds a default \newline expression and makes
default footnote titles flatten parsed child nodes instead of assuming the
first child is plain text.

diff --git a/htmlisp/parsers/latex/defaultExpressions.js b/htmlisp/parsers/latex/defaultExpressions.js
index 0000000..0000000 100644
--- a/htmlisp/parsers/latex/defaultExpressions.js
+++ b/htmlisp/parsers/latex/defaultExpressions.js
@@ -202,6 +202,7 @@ var singles = {
   subsubsection: el("h4"),
   paragraph: el("b"),
   label: () => element("", []),
+  newline: () => " ",
   textbackslash: () => "\\",
   // Formatting
   texttt: el("code"),
@@ -244,8 +245,8 @@ var cites = (bibtexEntries) => ({
 var cites = (bibtexEntries) => ({
   footnote: (children, matchCounts) => {
     return {
       type: "sup",
-      attributes: { title: children[0] },
+      attributes: { title: childrenToText(children) },
       children: [
         (matchCounts.footnote ? matchCounts.footnote.findIndex((e) => e === children[0]) + 1 : 1).toString()
       ]
@@ -416,6 +417,11 @@ function element(type, children, attributes) {
     children
   };
 }
+function childrenToText(children) {
+  return children.map((child) =>
+    typeof child === "string" ? child : childrenToText(child.children || [])
+  ).join("");
+}
 export {
   blocks,
   cites,
diff --git a/htmlisp/parsers/latex/parseLatex.js b/htmlisp/parsers/latex/parseLatex.js
index 0000000..0000000 100644
--- a/htmlisp/parsers/latex/parseLatex.js
+++ b/htmlisp/parsers/latex/parseLatex.js
@@ -97,6 +97,6 @@ var STATES = {
 };
 var LIMIT2 = 1e5;
-function getParseSingle(expressions) {
+function getParseSingle(expressions, nestedParsers = []) {
   return function parseSingle(getCharacter, matchCounts) {
     let state = STATES.IDLE;
     let foundKey = "";
@@ -147,8 +147,19 @@ function getParseSingle(expressions) {
           getCharacter.previous();
           try {
-            const ret = parseSingle(getCharacter, matchCounts);
-            if (ret) {
-              parts.push(ret.value);
+            const parseResult = runParsers(
+              getCharacter,
+              [parseSingle, ...nestedParsers],
+              matchCounts
+            );
+
+            if (parseResult?.match) {
+              if (parseResult.matchCounts) {
+                matchCounts = parseResult.matchCounts;
+              }
+              parts.push(parseResult.value);
+            } else {
+              getCharacter.setIndex(characterIndex - 1);
+              stringBuffer += readLatexCommand(getCharacter);
             }
           } catch (error) {
             if (error instanceof Error && error.message === "No matching expression was found") {
@@ -448,7 +460,7 @@ function parseLatex(input, parser) {
   input = stripLatexComments(input);
   const getCharacter = characterGenerator(input);
-  const singleParsers = parser.singles && getParseSingle(parser.singles);
   const doubleParsers = parser.doubles && getParseDouble(parser.doubles);
+  const singleParsers = parser.singles && getParseSingle(parser.singles, [doubleParsers].filter(Boolean));
   const blockParsers = parser.blocks && getParseBlock(parser.blocks);
   const listParsers = parser.lists && getParseBlock(parser.lists);
   const allParsers = [
diff --git a/tests/latex-parser.test.mjs b/tests/latex-parser.test.mjs
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/tests/latex-parser.test.mjs
@@ -0,0 +1,35 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  astToHTMLSync,
+  cites,
+  doubles,
+  htmlispToHTMLSync,
+  parseLatex,
+  singles,
+} from "../htmlisp/mod.js";
+
+test("parses double commands nested inside single command content", () => {
+  const ast = parseLatex(
+    String.raw`Research\footnote{Occasionally this is called \href{https://example.com}{sensemaking}.}`,
+    {
+      singles: { ...singles, ...cites({}) },
+      doubles,
+    },
+  );
+  const html = astToHTMLSync(ast, htmlispToHTMLSync);
+
+  assert.match(html, /title="Occasionally this is called sensemaking\."/);
+  assert.doesNotMatch(html, /\\href/);
+});
+
+test("handles LaTeX newline as spacing", () => {
+  const ast = parseLatex(String.raw`Literature\newline Review`, {
+    singles,
+    doubles,
+  });
+  const html = astToHTMLSync(ast, htmlispToHTMLSync);
+
+  assert.match(html, /Literature Review/);
+  assert.doesNotMatch(html, /\\newline/);
+});
